{
	"name": "adt/cockpit",
	"description": "Client of the Cockpit CMS v2 REST API with retries and a fallback to the last successful response",
	"type": "library",
	"license": "MIT",
	"autoload": {
		"psr-4": {
			"ADT\\Cockpit\\": "src/"
		}
	},
	"require": {
		"php": ">=8.3",
		"ext-json": "*",
		"guzzlehttp/guzzle": "^7.4"
	},
	"require-dev": {
		"nette/caching": "^3.2",
		"nette/tester": "^2.5",
		"tracy/tracy": "^2.10"
	},
	"suggest": {
		"nette/caching": "for Cockpit::setFallbackStorage()",
		"tracy/tracy": "for TracyLogger (Cockpit::setOnError())"
	},
	"scripts": {
		"test": "tester tests/ -C"
	}
}
